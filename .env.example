# Use true for a completely offline, simulated preview (no HA token required).
DEMO_MODE=true
PORT=3080

# Set DEMO_MODE=false to connect live devices.
HA_URL=http://10.0.0.169:8123
HA_TOKEN=

# Update these to the EXACT Home Assistant entity IDs from /api/entities.
LIGHT_ENTITY_ID=light.kontoret_main
SCENE_ENTITY_ID=scene.neo_noir
VACUUM_ENTITY_ID=
# Optional: Dreame battery may be a separate sensor in newer Home Assistant versions.
VACUUM_BATTERY_ENTITY_ID=
