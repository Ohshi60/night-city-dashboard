# Use true for a completely offline, simulated preview (no HA token required).
DEMO_MODE=true
PORT=3080

# Set DEMO_MODE=false to connect live devices. HA_URL and HA_TOKEN are then required.
# HA_URL includes the port. HAOS defaults to :8123; this install serves on :80.
HA_URL=http://10.0.0.169
HA_TOKEN=

# Optional, comma-separated. Empty = every scene / media player in Home Assistant.
# The lights shown are the ones the scenes control.
SCENE_ENTITY_IDS=
MEDIA_PLAYER_ENTITY_IDS=

# The EXACT Home Assistant entity ID from /api/entities (Dreame integration).
VACUUM_ENTITY_ID=vacuum.ottoto
# Optional: Dreame battery may be a separate sensor in newer Home Assistant versions.
VACUUM_BATTERY_ENTITY_ID=sensor.ottoto_battery_level

# Electricity prices from the Energi Data Service integration (card hidden if missing).
PRICE_ENTITY_ID=sensor.energi_data_service
# Appliances to find the cheapest start time for, as Name:minutes.
APPLIANCES=Washing machine:120,Dishwasher:180
